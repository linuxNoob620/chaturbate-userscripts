{
  "name": "ziggy-chaturbate-suite",
  "version": "16.5.30",
  "private": true,
  "description": "Builds the maintained Tampermonkey userscript and strict-parity Chrome and Firefox/Zen extensions.",
  "scripts": {
    "build": "npm run build:userscript && node ./tools/build-extensions.mjs all && node ./tools/verify-extension-parity.mjs",
    "build:userscript": "node ./tools/validate-userscripts.mjs --write-meta && node ./tools/validate-userscripts.mjs",
    "build:chrome": "node ./tools/build-extensions.mjs chrome && node ./tools/verify-extension-parity.mjs chrome",
    "build:firefox": "node ./tools/build-extensions.mjs firefox && node ./tools/verify-extension-parity.mjs firefox",
    "package": "npm run build",
    "test": "node ./tools/validate-userscripts.mjs && node ./tools/test-github-sync.mjs && node ./tools/test-extension-adapters.mjs && node ./tools/verify-extension-parity.mjs"
  },
  "dependencies": {
    "hls.js": "1.6.16",
    "mediabunny": "1.55.5"
  },
  "engines": {
    "node": ">=22"
  }
}
